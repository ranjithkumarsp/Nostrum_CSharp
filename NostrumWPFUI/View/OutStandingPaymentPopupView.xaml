<Window x:Class="Nostrum.View.OutStandingPaymentPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nostrum.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:behaviors="clr-namespace:Nostrum.Behaviours"
        mc:Ignorable="d"
        Title="OutStandingPaymentPopupView" Height="750" Width="750"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" 
        behaviors:WndExitAftConfirmBehaviour.Enabled="True"
        >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding OnLoadedCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowCloseCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>           
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="350"/>            
            <ColumnDefinition Width="158*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="SaveasPdfButton" Content="Print" Style="{StaticResource BoldLinkButton}" Grid.Row="0" Grid.Column="3" Command="{Binding SaveAsPDFCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}}" />
        <Border x:Name="HeaderGridBorder" Grid.Row="1" Grid.Column="1"  Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="3">
            <Grid Name="HeaderGrid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="1"/>                    
                </Grid.RowDefinitions>
                <TextBlock Text="NOSTRUM BIOTECH" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="36" FontFamily="Times New Roman" />
                <TextBlock Text="9/A, Shafiullah Street, R K Pet, Arni - 632 301."  Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="16"/>
                <TextBlock Text="Tiruvannamalai District, Tamilnadu."  Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="14"/>
                <TextBlock Text=" Ph: 9942529828, Email: nostrumbiotech@gmail.com"  Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="14"/>
                <!--<Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="9" BorderBrush="Gray" Background="Gray" BorderThickness="2"/>-->                
            </Grid>

        </Border>

        <Border x:Name="DataGridBorder" Grid.Row="3" Grid.Column="1"  Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="350"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="OUTSTANDING UP TO:" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Arial" FontSize="20" FontStyle="Normal" FontWeight="UltraBold"/>
                <TextBlock Text="14-FEB 2020" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" FontFamily="Arial" FontSize="20" FontStyle="Normal" FontWeight="UltraBold"/>
                <DataGrid Name="OutstandingPaymentGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                          MinWidth="450" Margin="1,1,1,1"
                          ItemsSource="{Binding OutstandingPaymentGridCollection}" AutoGenerateColumns="False"
                          ColumnWidth="*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          EnableRowVirtualization="false" EnableColumnVirtualization="false" 
                           HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          FlowDirection="LeftToRight" FontSize="15" 
                          CanUserAddRows="False" CanUserReorderColumns="False"
                          CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" IsReadOnly="True" 
                          >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="S.No" Binding="{Binding SerialNo}"/>
                        <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate}"/>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding InvoiceAmount}"/>
                    </DataGrid.Columns>
            
            
            </DataGrid>
                <TextBlock Text="TOTAL : " Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18" FontWeight="Heavy"/>
                <TextBlock Text="{Binding TotalOutStanding,UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" 
                           HorizontalAlignment="Left" FontSize="18" FontWeight="Heavy" Margin="0,0,0,0"/>
                <TextBlock Text="With Regards," Grid.Row="4" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="16" FontWeight="Normal"/>
                <TextBlock Text="Rajganesh.S" Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="15" FontWeight="Normal"/>
            </Grid>
        </Border>

    </Grid>
</Window>
