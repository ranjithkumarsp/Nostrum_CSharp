<Window x:Class="Nostrum.View.OutStandingPaymentGridPopupView"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nostrum.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        Title="StockDisplayPopupView"
        Height="750" Width="800"
        xmlns:converters="clr-namespace:Nostrum.Converters"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        >
    <Window.Resources>
        <converters:DataToRowBackgroundColorConverter x:Key="RowBackGroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="250*"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="10"/>

        </Grid.RowDefinitions>

        <Border x:Name="HeaderGridBorder" Grid.Row="1" BorderBrush="Gray" BorderThickness="3">
            <Grid Name="HeaderGrid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <TextBlock Text="NOSTRUM BIOTECH" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="36" FontFamily="Times New Roman" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid Name="ClientInvoice" Width="779" Height="Auto"
                          Margin="5,5,0,0"
                          ItemsSource="{Binding ClientPaymentCollection}" AutoGenerateColumns="False"
                          ColumnWidth="auto" HorizontalAlignment="Left" VerticalAlignment="Top"
                          EnableRowVirtualization="false" EnableColumnVirtualization="false" 
                          FlowDirection="LeftToRight" FontSize="15" CanUserResizeColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" 
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsGridVisible,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanToVisibilityConverter}}"                          
                          >
                <DataGrid.Resources>
                    <!--Style to disable blue background on Selection-->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                    <!--Style to disable White Foreground background on Selection-->
                    <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}" >
                        <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <!--<Setter Property="BorderThickness" Value="0"/>-->
                                <Setter Property="BorderBrush" Value="CornflowerBlue"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}"></TextBlock>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="TxtColumnElementStyle" TargetType="TextBlock">
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>

                </DataGrid.Resources>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <!--<prism:InvokeCommandAction Command="{Binding SelectedCommand}" TriggerParameterPath="AddedItems" />-->
                        <i:InvokeCommandAction Command="{Binding SelectedCommand}" CommandParameter="{Binding ElementName=ClientInvoice,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" >
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource RowBackGroundConverter}" >
                                    <Binding Path="Amount" />
                                    <Binding Path="Balance" />
                                    <Binding RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" >
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource RowBackGroundConverter}" >
                                            <Binding Path="Amount" />
                                            <Binding Path="Balance" />
                                            <Binding RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice Number" Binding="{Binding InvoiceNo}" Width="165" CanUserResize="False" />
                    <DataGridTextColumn Header="Client" Binding="{Binding Client}" ElementStyle="{StaticResource TxtColumnElementStyle}" MinWidth="155" Width="200" CanUserResize="False"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="145" CanUserResize="False"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="130" CanUserResize="False"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="130" CanUserResize="False"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
        <TextBlock Text="Total Number of Records :" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="15" FontWeight="DemiBold"/>
        <TextBlock Text="{Binding TotalRecords,UpdateSourceTrigger=PropertyChanged}" Grid.Row="3"  VerticalAlignment="Center" FontSize="15" FontWeight="DemiBold" Margin="180,0,420,0"/>
    </Grid>
</Window>
