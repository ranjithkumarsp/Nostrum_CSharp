<Window x:Class="NostrumWPFUI.View.ViewOldPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:NostrumWPFUI.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        Title="View Old" Height="360" Width="450" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        >
    <i:Interaction.Triggers>        
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding OnLoadedCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowCloseCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <ResourceDictionary Source="../Styles/NostrumUIStyles.xaml"/>
    </Window.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>            
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>            
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Text="Client" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"  />
        <ComboBox Name="LoadClientCombo" ItemsSource="{Binding ClientsList}" SelectedItem="{Binding SelectedClient,UpdateSourceTrigger=PropertyChanged}" Width="120" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"   TextWrapping="Wrap" Text="From"  Height="23"  FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
        <xctk:DateTimePicker Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Width="143" Height="30" />
        
        <TextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"   TextWrapping="Wrap" Text="To"  Height="23"  FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" ClipToBounds="True" SnapsToDevicePixels="True" />
        <xctk:DateTimePicker Format="ShortDate" TimePickerVisibility="Hidden"  TimePickerShowButtonSpinner="False" Grid.Row="5" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Width="143" Height="30" />
        
        <TextBlock Grid.Row="7" Grid.Column="1"  HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Invoice Number" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold"/>
        <ComboBox Name="InvoiceCombo" ItemsSource="{Binding ClientsList}" SelectedItem="{Binding SelectedClient,UpdateSourceTrigger=PropertyChanged}" Width="120" Grid.Row="7" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Button Content="Open" Command="{Binding OpenRelayCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Grid.Row="9" Grid.Column="1"  Height="25"  Width="100" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Button Content="CANCEL" Command="{Binding CancelRelayCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Grid.Row="9" Grid.Column="3"  Height="25" Width="100" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

    </Grid>
</Window>
