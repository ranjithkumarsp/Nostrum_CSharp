<Window x:Class="NostrumWPFUI.View.AddLineItemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NostrumWPFUI.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        Title="AddLineItems" Height="314.72" Width="401.733"        
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" 
        >
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="99,31,0,0" TextWrapping="Wrap" Text="Product" VerticalAlignment="Top" Height="23"/>
        <ComboBox ItemsSource="{Binding Products}"  HorizontalAlignment="Left" Margin="228,25,0,0" VerticalAlignment="Top" Width="120" IsEditable="True" IsSynchronizedWithCurrentItem="True" IsTabStop="True" StaysOpenOnEdit="True" AllowDrop="True"
                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=LostFocus}">
            <ComboBox.Style>
                <Style TargetType="ComboBox">
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="IsDropDownOpen" Value="true" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="99,61,0,0" TextWrapping="Wrap" Text="Batch" VerticalAlignment="Top" Height="23"/>
        <ComboBox ItemsSource="{Binding Batches}" HorizontalAlignment="Left" Margin="228,55,0,0" VerticalAlignment="Top" Width="120" IsEditable="True" IsSynchronizedWithCurrentItem="True" IsTabStop="True" StaysOpenOnEdit="True" AllowDrop="True"
                  SelectedItem="{Binding CurrentLineItem.Batch}">
            <ComboBox.Style>
                <Style TargetType="ComboBox">
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="IsDropDownOpen" Value="true" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="99,91,0,0" TextWrapping="Wrap" Text="Packing" VerticalAlignment="Top" Height="23"/>
        <TextBlock HorizontalAlignment="Left" Margin="99,121,0,0" TextWrapping="Wrap" Text="Offer" VerticalAlignment="Top" Height="23"/>
        <TextBlock HorizontalAlignment="Left" Margin="99,150,0,0" TextWrapping="Wrap" Text="Quantity" VerticalAlignment="Top" Height="23"/>
        <TextBlock HorizontalAlignment="Left" Margin="99,183,0,0" TextWrapping="Wrap" Text="Rate" VerticalAlignment="Top" Height="23"/>
        <TextBox Text="{Binding CurrentLineItem.Pack1, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" Height="16" Margin="228,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="45"
                 IsEnabled="{Binding IsProductSolid, Mode=OneWay}"/>
        <TextBlock HorizontalAlignment="Left" Margin="283,91,0,0" TextWrapping="Wrap" Text="{Binding PackingUnitText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  VerticalAlignment="Top" Width="18"/>
        <TextBox Text="{Binding CurrentLineItem.Pack2, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 Visibility="{Binding IsProductSolid,Mode=OneWay,Converter={StaticResource BooleanToVisibilityConverter}}"
                 HorizontalAlignment="Left" Height="16" Margin="311,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="37"/>
        <TextBox Text="{Binding CurrentLineItem.Offer1, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" Height="16" Margin="228,121,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="45"/>
        <TextBlock HorizontalAlignment="Left" Margin="283,121,0,0" TextWrapping="Wrap" Text="+" VerticalAlignment="Top" Width="18"/>
        <TextBox Text="{Binding CurrentLineItem.Offer2, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" Height="16" Margin="311,121,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="35"/>
        <TextBox x:Name="txtQuantity" GotKeyboardFocus="OnQuantityEnter" ToolTip="{Binding AvailableQtyToolTipString, UpdateSourceTrigger=PropertyChanged}"  Text="{Binding CurrentLineItem.Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" Height="23" Margin="228,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="GotKeyboardFocus">
                    <i:InvokeCommandAction Command="{Binding QtyEnterCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
        <Popup x:Name="qtyPopUp" Opened="QuantityPopUpOpened" Placement="Top" PlacementTarget="{Binding ElementName=txtQuantity}" IsOpen="False">
            <TextBlock Text="{Binding AvailableQtyToolTipString, UpdateSourceTrigger=PropertyChanged}" Background="Wheat"/>
        </Popup>
        <TextBox IsEnabled="{Binding SaleOrder}" Text="{Binding CurrentLineItem.Rate, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" HorizontalAlignment="Left" Height="23" Margin="228,185,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Content="Add Next" Command="{Binding AddNextCommand}" HorizontalAlignment="Left" Margin="123,229,0,0" VerticalAlignment="Top" Width="75" Height="27" />
        <Button Content="Generate Bill" Command="{Binding GenBillCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" HorizontalAlignment="Left" Margin="228,229,0,0" VerticalAlignment="Top" Width="86" Height="27"/>
    </Grid>
</Window>
