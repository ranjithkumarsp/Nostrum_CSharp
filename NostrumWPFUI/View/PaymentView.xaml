<UserControl x:Class="NostrumWPFUI.View.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:local="clr-namespace:NostrumWPFUI.View" x:Name="PaymentMainView"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:NostrumWPFUI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:DataToRowBackgroundColorConverter x:Key="RowBackGroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="Paymentheader" Height="55"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="150"/>
                <RowDefinition x:Name="Paymentfooter" Height="55"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PaymentLeftMargin" Width="140"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition x:Name="PaymentRightMargin" Width="80"/>
            </Grid.ColumnDefinitions>
            <Button Content="Refresh" Style="{StaticResource BoldLinkButton}" Grid.Row="0" Grid.Column="5" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Row="1"  Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"  TextWrapping="Wrap" Text="Client Name"  Height="23" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold" />
            <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"   TextWrapping="Wrap" Text="From"  Height="23"  FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"   TextWrapping="Wrap" Text="To"  Height="23"  FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" ClipToBounds="True" SnapsToDevicePixels="True" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding ClientsList}" Grid.Column="4"  HorizontalAlignment="Left" VerticalAlignment="Center" Width="169"  Height="30" IsEditable="True" IsSynchronizedWithCurrentItem="True" IsTabStop="True" StaysOpenOnEdit="True" AllowDrop="True" 
                      SelectedItem="{Binding SelectedClient}"/>

            <DatePicker SelectedDate="{Binding FromDate, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" SelectedDateFormat="Short" Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="143" Height="30" />
            <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" SelectedDateFormat="Short" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="143" Height="30" />
            <Grid Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Button Content="Invoice Details" Grid.Column="0"  Height="30"  VerticalAlignment="Center" Command="{Binding InvoiceDetailsCommand}" Grid.ColumnSpan="3" Margin="56,5,120.6,0"/>
                <Button Content="Outstanding" Grid.Column="2" Height="30" Command="{Binding OutStandingDetailsCommand}"  VerticalAlignment="Center" Margin="56.2,5,-56.4,0" />
            </Grid>
            <ScrollViewer Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="4" Visibility="{Binding IsClientInvoiceGridVisible,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanToVisibilityConverter}}"  Grid.RowSpan="2">
                <DataGrid Name="ClientInvoice"  MinHeight="100" Height="166" Width="403"  
                          ItemsSource="{Binding ClientPaymentCollection}" AutoGenerateColumns="False"
                          ColumnWidth="auto" HorizontalAlignment="Left" VerticalAlignment="Top"
                          EnableRowVirtualization="false" EnableColumnVirtualization="false" 
                          FlowDirection="LeftToRight" FontSize="15" CanUserResizeColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" 
                          Visibility="{Binding IsGridVisible,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanToVisibilityConverter}}"                         
                          >
                    <DataGrid.Resources>
                        <!--Style to disable blue background on Selection-->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                        <!--Style to disable White Foreground background on Selection-->
                        <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}" >
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <!--<Setter Property="BorderThickness" Value="0"/>-->
                                    <Setter Property="BorderBrush" Value="CornflowerBlue"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <!--<prism:InvokeCommandAction Command="{Binding SelectedCommand}" TriggerParameterPath="AddedItems" />-->
                            <i:InvokeCommandAction Command="{Binding SelectedCommand}" CommandParameter="{Binding ElementName=ClientInvoice,Path=SelectedItem}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" >
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource RowBackGroundConverter}" >
                                        <Binding Path="Amount" />
                                        <Binding Path="Balance" />
                                        <Binding RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" >
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RowBackGroundConverter}" >
                                                <Binding Path="Amount" />
                                                <Binding Path="Balance" />
                                                <Binding RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice Number" Binding="{Binding InvoiceNo}" Width="*" CanUserResize="False"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="Auto" CanUserResize="False"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="Auto" CanUserResize="False"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="Auto" CanUserResize="False"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="Auto" CanUserResize="False"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
