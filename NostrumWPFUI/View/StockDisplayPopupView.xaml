<Window x:Class="NostrumWPFUI.View.StockDisplayPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NostrumWPFUI.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        Title="StockDisplayPopupView"
        Height="650" Width="750"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding OnLoadedCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowCloseCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="300*"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="158*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="HeaderGridBorder" Grid.Row="1" Grid.Column="1"  Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="3">
            <Grid Name="HeaderGrid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="NOSTRUM BIOTECH" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="36" FontFamily="Times New Roman" />
                <TextBlock Text="{Binding TxtProduct}"  Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="16"/>
                <TextBlock Text="{Binding TxtFromTo}"  Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="14"/>
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="9" BorderBrush="Gray" Background="Gray" BorderThickness="2"/>
            </Grid>

        </Border>

        <Border x:Name="DataGridBorder" Grid.Row="3" Grid.Column="1"  Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="3">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="230*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <!--<TextBlock Text="OUTSTANDING UP TO:" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Arial" FontSize="20" FontStyle="Normal" FontWeight="UltraBold"/>-->
                <!--<TextBlock Text="14-FEB 2020" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" FontFamily="Arial" FontSize="20" FontStyle="Normal" FontWeight="UltraBold"/>-->
                <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" >
                    <DataGrid Name="OutstandingPaymentGrid" 
                          MinWidth="450" MinHeight="100" Height="Auto"  
                          ItemsSource="{Binding StockDisplayCollection}" AutoGenerateColumns="False"
                          ColumnWidth="*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          EnableRowVirtualization="false" EnableColumnVirtualization="false" 
                          FlowDirection="LeftToRight" FontSize="15" 
                          CanUserAddRows="False" CanUserReorderColumns="False"
                          IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}"/>
                            <DataGridTextColumn Header="InvoiceNo" Binding="{Binding InvoiceNo}"/>
                            <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}"/>
                            <DataGridTextColumn Header="BatchNo" Binding="{Binding BatchNo}"/>

                            <DataGridTextColumn Header="ManufactureDate" Binding="{Binding ManufactureDate}"/>
                            <DataGridTextColumn Header="ExpiryDate" Binding="{Binding ExpiryDate}"/>
                            <DataGridTextColumn Header="PurchaseQty" Binding="{Binding PurchaseQty}"/>
                            <DataGridTextColumn Header="SaleQty" Binding="{Binding SaleQty}"/>

                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}"/>

                        </DataGrid.Columns>


                    </DataGrid>
                </ScrollViewer>
                
                <!--<TextBlock Text="TOTAL" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Heavy"/>
                <TextBlock Text="{Binding TotalOutStanding,UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Heavy"/>-->
            </Grid>
        </Border>

    </Grid>
</Window>
