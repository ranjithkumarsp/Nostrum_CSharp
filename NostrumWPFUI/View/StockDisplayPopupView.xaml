<Window x:Class="Nostrum.View.StockDisplayPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nostrum.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        Title="StockDisplayPopupView"
        Height="750" Width="815"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="45"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="SaveasPdfButton" Content="Print" Style="{StaticResource BoldLinkButton}" Grid.Row="0" Grid.Column="3" Command="{Binding SaveAsPDFCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                CommandParameter="{Binding ElementName=StockPrintableGrid}" Margin="0,0,15,0" />
    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" x:Name="StockPrintableGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="300*"/>                   
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <!--<Button x:Name="SaveasPdfButton" Content="Print" Style="{StaticResource BoldLinkButton}" Grid.Row="0" Grid.Column="3" Command="{Binding SaveAsPDFCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}}}" />-->
        <Border x:Name="HeaderGridBorder" Grid.Row="1" Grid.Column="1"  Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="3">
            <Grid Name="HeaderGrid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="NOSTRUM BIOTECH" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="36" FontFamily="Times New Roman" />
                <TextBlock Text="{Binding TxtProduct}"  Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="16"/>
                <TextBlock Text="{Binding TxtFromTo}"  Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Unicode MS" FontSize="14"/>
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="9" BorderBrush="Gray" Background="Gray" BorderThickness="2"/>
            </Grid>
        </Border>
        <Border x:Name="DataGridBorder" Grid.Row="3" Grid.Column="1"  Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="230*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="3"/>
                </Grid.ColumnDefinitions>

                
                <!--<ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">-->                    
                <DataGrid Name="OutstandingPaymentGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Background="Transparent" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          MinHeight="100" Height="Auto" Width="Auto" 
                          ItemsSource="{Binding StockDisplayCollection}" 
						  AutoGenerateColumns="False" Margin="2,0,5,0"
                          CanUserAddRows="False" 
						  SelectionMode="Single" 
						  SelectionUnit="FullRow"						  
						  CanUserReorderColumns="False" CanUserResizeColumns="False"                         
                          IsReadOnly="True">
                    <DataGrid.Resources>
                        <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}" >
                            <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow"/>
                        </Style>
                        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding}"></TextBlock>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd-MMM-yyyy'}" Width="90"/>
                            <DataGridTextColumn Header="InvoiceNo" Binding="{Binding InvoiceNo}" Width="80" />
                        <DataGridTextColumn Header="Buyer/Seller" Binding="{Binding Manufacturer}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>                        
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="BatchNo" Binding="{Binding BatchNo}" Width="80"/>
                            <DataGridTextColumn Header="Mfd Date" Binding="{Binding ManufactureDate}" Width="80"/>
                            <DataGridTextColumn Header="Exp Date" Binding="{Binding ExpiryDate}" Width="80"/>
                            <DataGridTextColumn Header="Purchase Qty" HeaderStyle="{StaticResource WrappedColumnHeaderStyle}" Binding="{Binding PurchaseQty}" Width="80"/>
                            <DataGridTextColumn Header="Sale Qty" Binding="{Binding SaleQty}" Width="60"/>

                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="Auto"/>
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}"  Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                <!--</ScrollViewer>-->                
                <!--<TextBlock Text="TOTAL" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Heavy"/>
                <TextBlock Text="{Binding TotalOutStanding,UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Heavy"/>-->                
            </Grid>
        </Border>

    </Grid>
        </Grid>
</Window>
