<Window x:Class="Nostrum.View.MakePaymentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nostrum.View"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="MakePaymentView" Height="390" Width="550"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        >
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
                <Setter Property="FontStyle" Value="Normal"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="18"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="21*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Header, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" TextAlignment="Center" Margin="141,41,97,100.2" Height="30"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Invoice" VerticalAlignment="Top" TextAlignment="Right" Margin="87,97,0,0" Height="30" Width="169" />

        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Width="134"  Height="30" Margin="302,97,0,44.373"
                  Text ="{Binding InvoiceNumber, Mode=OneWay}"/>

        <TextBlock HorizontalAlignment="Left" Height="30" Margin="85,147,0,0" TextWrapping="NoWrap" Text="Outstanding Balance" VerticalAlignment="Top" Width="169" TextAlignment="Right" Grid.RowSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Height="30" Margin="85,25.627,0,0" TextWrapping="NoWrap" Text="Payment To Make" VerticalAlignment="Top" Width="169" TextAlignment="Right" Grid.Row="1"/>

        <TextBox HorizontalAlignment="Left" Height="30" Margin="302,147,0,0" TextWrapping="NoWrap"  VerticalAlignment="Top" Width="134"
                 TextAlignment="Right"
                 Text="{Binding OutstandingBalance,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                 IsEnabled="False" Grid.RowSpan="2" />

        <TextBox HorizontalAlignment="Left" Height="30" Margin="302,25.627,0,0" TextWrapping="NoWrap"  VerticalAlignment="Top" Width="134"
            TextAlignment="Right"
            Text="{Binding PaymentAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Grid.Row="1"
                 />
        <Button Content="Make Payment" IsDefault="True" HorizontalAlignment="Left" Margin="141,123.8,0,0" VerticalAlignment="Top" Width="128" Height="32"
                Command="{Binding MakePaymentCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                Grid.Row="1"
                />
        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Left" Margin="302,123.8,0,0" VerticalAlignment="Top" Width="134" Height="32" RenderTransformOrigin="1.607,0.722" Grid.Row="1"/>
        <TextBlock HorizontalAlignment="Left" Height="30" Margin="85,74.8,0,0" TextWrapping="NoWrap" Text="Pay Date" VerticalAlignment="Top" Width="169" TextAlignment="Right" Grid.Row="1"/>
        <DatePicker SelectedDate="{Binding PayDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedDateFormat="Short" HorizontalAlignment="Left" Height="30" Margin="302,74.8,0,0" VerticalAlignment="Top" Width="134"  Grid.Row="1"/>

    </Grid>
</Window>
