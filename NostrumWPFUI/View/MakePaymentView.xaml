<Window x:Class="NostrumWPFUI.View.MakePaymentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NostrumWPFUI.View"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="MakePaymentView" Height="390" Width="550"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        >
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
                <Setter Property="FontStyle" Value="Normal"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="18"/>
            </Style>
        </Grid.Resources>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Invoice" VerticalAlignment="Top" TextAlignment="Center" Margin="154,47,0,0" Height="27" Width="101"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Center" Margin="273,47,0,0" Height="27" Width="149"
                   Text="{Binding SelectedClient.InvoiceNo,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                   />

        <TextBlock HorizontalAlignment="Left" Height="33" Margin="73,105,0,0" TextWrapping="NoWrap" Text="OutStanding Balance" VerticalAlignment="Top" Width="169"/>
        <!--<xctk:WatermarkTextBox Watermark="Address"-->
        <TextBlock HorizontalAlignment="Left" Height="29" Margin="95,156,0,0" TextWrapping="NoWrap" Text="Payment To Make" VerticalAlignment="Top" Width="160"/>
        
        <TextBox HorizontalAlignment="Left" Height="33" Margin="288,105,0,0" TextWrapping="NoWrap"  VerticalAlignment="Top" Width="134"
                 TextAlignment="Right"
                 Text="{Binding OutstandingBalance,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                 />
        <Button Content="Make Payment" IsDefault="True" HorizontalAlignment="Left" Margin="127,219,0,0" VerticalAlignment="Top" Width="128" Height="32"
                Command="{Binding MakePaymentCommand}"
                />
        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Left" Margin="317,219,0,0" VerticalAlignment="Top" Width="134" Height="32" RenderTransformOrigin="1.607,0.722"/>
        <TextBox HorizontalAlignment="Left" Height="33" Margin="288,152,0,0" TextWrapping="NoWrap"  VerticalAlignment="Top" Width="134"
            TextAlignment="Right"
            Text="{Binding PaymentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 />

    </Grid>
</Window>
