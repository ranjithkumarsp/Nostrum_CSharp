<UserControl x:Class="Nostrum.View.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nostrum.View"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:behaviors="clr-namespace:Nostrum.Behaviours"
             xmlns:EnhancedCombo="clr-namespace:DotNetKit.Windows.Controls;assembly=DotNetKit.Wpf.AutoCompleteComboBox"
             xmlns:EnhancedAutoCompleteTextBox="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/NostrumUIStyles.xaml"/>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding OnLoadedCmd}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="header1" Height="45"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="30"/>
                <RowDefinition x:Name="footer1" Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftMargin1" Width="140"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition x:Name="RightMargin1" Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Product" VerticalAlignment="Center" Height="23" Width="121" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold"  />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"  TextAlignment="Right" TextWrapping="Wrap" Text="Drug Type" VerticalAlignment="Center" Height="23" Width="121" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold"  />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"  TextAlignment="Right" TextWrapping="Wrap" Text="Batch No" VerticalAlignment="Center" Height="23" Width="100" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold"  />
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Mfg Date" VerticalAlignment="Center" Height="23" Width="130" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" ClipToBounds="True" SnapsToDevicePixels="True" />
            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Exp Date" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Packing" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="6" Grid.Column="4" HorizontalAlignment="Right" TextAlignment="Center"  TextWrapping="Wrap" Text="X" VerticalAlignment="Bottom" Height="23" Width="30" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold" Margin="0,0,0,10.4" Name="lblPackX"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Quantity" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right"  TextWrapping="Wrap" Text="CGST" VerticalAlignment="Center" Height="23" Width="121" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold"  />
            <TextBlock Grid.Row="8" Grid.Column="5" HorizontalAlignment="Right" TextAlignment="Left"  TextWrapping="Wrap" Text="%" VerticalAlignment="Center" Height="23" Width="85" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold" Margin="0,8.6,0.2,8.4" />
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right"  TextWrapping="Wrap" Text="SGST" VerticalAlignment="Center" Height="23" Width="100" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="9" Grid.Column="5" HorizontalAlignment="Right" TextAlignment="Left"  TextWrapping="Wrap" Text="%" VerticalAlignment="Center" Height="23" Width="85" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold" Margin="0,8.6,0.2,8.4" />
            <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right"  TextWrapping="Wrap" Text="MRP" VerticalAlignment="Center" Height="23" Width="130" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" ClipToBounds="True" SnapsToDevicePixels="True" />
            <TextBlock Grid.Row="10" Grid.Column="5" HorizontalAlignment="Right" TextAlignment="Left"  TextWrapping="Wrap" Text="For 1 Stripe" VerticalAlignment="Center" Height="23" Width="85" FontSize="16" FontFamily="Century Gothic" FontWeight="Bold" Margin="0,11.6,0.2,5.4" Name="lblMRP" />
            <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Manufacturer" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Date of Purchase" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold" />
            <TextBlock Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="Invoice Number" VerticalAlignment="Center" Height="23" Width="135" FontFamily="Century Gothic" FontSize="16" FontWeight="Bold"/>

            <EnhancedCombo:AutoCompleteComboBox Text ="{Binding ProductName}" IsEditable="True" IsEnabled="{Binding IsNewProduct, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"  Grid.Row="1" Grid.Column="4"  HorizontalAlignment="Left" VerticalAlignment="Center" Width="169"   Grid.ColumnSpan="2" Height="30" 
                      ItemsSource="{Binding ProductNameCollection}" IsDropDownOpen="True"/>
            <ComboBox Name="cmbDrugType" Grid.Row="2" ItemsSource="{Binding DrugTypeList}" Grid.Column="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="169"  Height="30" IsSynchronizedWithCurrentItem="True" IsTabStop="True" AllowDrop="True" 
                      SelectedItem="{Binding Type, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                      SelectionChanged="DrugTypeChanged"/>
            <TextBox Text ="{Binding BatchNo}" IsEnabled="{Binding IsNewProduct, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="169" Grid.ColumnSpan="2" TextAlignment="Left"/>
            <TextBox Text ="{Binding MfgDate}" Grid.Row="4" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="169" Height="30" Grid.ColumnSpan="2" TextAlignment="Left" />
            <TextBox Text ="{Binding ExpDate}" Grid.Row="5" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="169" Height="30" Grid.ColumnSpan="2" TextAlignment="Left" />
            <TextBox Text ="{Binding Pack1}" Grid.Row="6" Grid.Column="3" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="51" TextAlignment="Center" Margin="8.6,3.6,0,6.4" Grid.ColumnSpan="2" Name="txtPack1"/>
            <TextBox Text ="{Binding Pack2}" Grid.Row="6" Grid.Column="5" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="51" TextAlignment="Center" Margin="9,3.6,0,6.4" Name="txtPack2"/>
            <TextBox Text ="{Binding Quantity}" Grid.Row="7" Grid.Column="4" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="80" TextAlignment="Right" Margin="0,4.6,0,5.4" />
            <TextBox Text ="{Binding CGST}" Grid.Row="8" Grid.Column="4" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="80" TextAlignment="Right" Margin="0,4.6,0,5.4" />
            <TextBox Text ="{Binding SGST}" Grid.Row="9" Grid.Column="4" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="80" TextAlignment="Right" Margin="0,4.6,0,5.4" />
            <TextBox Text ="{Binding MRP,StringFormat={}{0:F2}}" Grid.Row="10" Grid.Column="4" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="80" TextAlignment="Right" Margin="0,4.6,0,5.4" Cursor="None" />
            <EnhancedAutoCompleteTextBox:AutoCompleteBox x:Name="manufactTextBox" Text ="{Binding Manufacturer,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                     ItemsSource="{Binding ManfAutoCompleteCollection}" FilterMode="Contains"
                     BorderThickness="2" Grid.Row="11" Grid.Column="4" HorizontalAlignment="Left" Height="30"  
                     VerticalAlignment="Center" Width="169" Grid.ColumnSpan="2"/>
            <DatePicker SelectedDateFormat="Short" SelectedDate ="{Binding PurchaseDate}" Grid.Row="12" Grid.Column="4"  HorizontalAlignment="Left" VerticalAlignment="Center" Width="169" Height="30" Grid.ColumnSpan="2"  />
            <TextBox Text ="{Binding PurchaseInvoiceNo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" BorderThickness="2" Grid.Row="13" Grid.Column="4" HorizontalAlignment="Left" Height="30"  TextWrapping="Wrap" VerticalAlignment="Center" Width="169" Grid.ColumnSpan="2" TextAlignment="Left" />
            <Button Content="EditProduct" Style="{StaticResource BoldLinkButton}" Grid.Row="1" Grid.Column="6" Command="{Binding EditProductCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <Grid Grid.Row="15" Grid.Column="2" Grid.ColumnSpan="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Button IsDefault="True" Content="{Binding SubmitButtonText,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Grid.Column="0" Command="{Binding SubmitCommand}" Height="30" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Button Content="Clear" Grid.Column="2" Command="{Binding ClearCommand}" Height="30" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
