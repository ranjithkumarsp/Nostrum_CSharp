    <Style TargetType="{x:Type ComboBox}">
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="IsDropDownOpen" Value="true" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type EnhancedCombo:AutoCompleteComboBox}">
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="IsDropDownOpen" Value="true" />
            </Trigger>
        </Style.Triggers>
    </Style>
   


