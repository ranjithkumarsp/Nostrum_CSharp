<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <log4net>
    <root>
      <level value="ALL" />
      <appender-ref ref="console" />
      <appender-ref ref="file" />
      <appender-ref ref="RollingFileAppender" />
    </root>
    <appender name="console" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %level %logger - %message%newline" />
      </layout>
    </appender>
    <appender name="file" type="log4net.Appender.RollingFileAppender">
      <!--<file value="Nostrum.log" />-->
       <file type="log4net.Util.PatternString" value="${APPDATA}\Nostrum Logs\Nostrum.log"/>
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{dd/MM/yyyy HH:mm:ss.ffff} $%username$ [%thread] %level  %logger %method - %message%newline" />
        <!--<conversionPattern value="%date{dd/MM/yyyy HH:mm:ss.ffff} [%thread] %level %logger $ %location %username %method %timestamp %message%newline" />-->

      </layout>
    </appender>
    
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
       <!--<file type="log4net.Util.PatternString" value="App_Data\Logs\TraceLog.%property{log4net:HostName}.txt" />-->
       <file type="log4net.Util.PatternString" value="${APPDATA}\Nostrum Daily Logs\NostrumLog $%property{log4net:HostName}$.log"/>
       <appendToFile value="true" />
       <rollingStyle value="Once" />
       <maxSizeRollBackups value="5" />
       <maximumFileSize value="5MB" />
       <staticLogFileName value="true" />
       <layout type="log4net.Layout.PatternLayout">
          <conversionPattern value="%date{dd/MM/yyyy HH:mm:ss.ffff} $%username$ [%thread] %level  %logger %method - %message%newline" />
       </layout>
    </appender>
  
  </log4net>
  <appSettings>
    <add key="log4net.Internal.Debug" value="true"/>
  </appSettings>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add
            name="textWriterTraceListener"
            type="System.Diagnostics.TextWriterTraceListener"
            initializeData="D:\NostrumLogs\log4net.txt" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>