<Window x:Class="NostrumWPFUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:NostrumWPFUI"
        xmlns:Views="clr-namespace:NostrumWPFUI.View"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        mc:Ignorable="d"
        Title="Nostrum" Name="NostrumMainWindow" 
        Height="750" Width="850" Closing="NostrumMainWindow_Closing"
        WindowStartupLocation="CenterScreen"  ResizeMode="CanMinimize"
        >
    <Grid>
        <!--<Menu Name="FileMenu" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" MinWidth="750" Width="{Binding ElementName=NostrumMainWindow,Path=Width}">
            <MenuItem Name="File" Header="File">
                <MenuItem Header="Open"/>
                <MenuItem Header="Save"/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Name="Data" Header="Data"/>
            <MenuItem Name="Import" Header="Import">
                <MenuItem Header="Single Excel" Command="{Binding SingleExcelImportCommand}"/>
                <MenuItem Header="Batch Excel"/>
            </MenuItem>
            <MenuItem Name="Help" Header="Help">
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>-->
        <TabControl  TabStripPlacement="Top" HorizontalAlignment="Left" Height="{Binding ElementName=NostrumMainWindow,Path=Height}" VerticalAlignment="Top" Width="{Binding ElementName=NostrumMainWindow,Path=Width}" 
                     Margin="0,0,0,0" SelectedIndex="0" SelectionChanged="TabControl_SelectionChanged">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding TabSelectionChangedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TabItem Header="Billing" Name="BillingTab">
                <Views:BillingView/>
            </TabItem>
            <TabItem Header="Payment" Name="PaymentTab">
                <Views:PaymentView/>
            </TabItem>
            <TabItem Header="Products" Name="ProductsTab">
                <Views:ProductsView/>
            </TabItem>
            <TabItem Header="Clients" Name="ClientsTab">
                <Views:ClientsView/>
            </TabItem>
            <TabItem Header="Stocks" Name="StocksTab">
                <Views:StocksView/>
            </TabItem>
            <!--<TabItem Header="Import Excel" Name="ImportExcelTab">
                <Views:ExcelImportView/>
            </TabItem>-->
        </TabControl>


    </Grid>
</Window>
